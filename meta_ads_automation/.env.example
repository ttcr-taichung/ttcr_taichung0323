# 複製為 .env 並填入實際值，或直接用 export 設定環境變數。
# 絕對不要把 .env 或真實 Token commit 進版控。

# Meta 長期存取權杖（System User Token 或長效 User Token，需具備該廣告帳號的讀取權限）
META_ACCESS_TOKEN=

# 選填，預設 v21.0
META_API_VERSION=v21.0

# 選填，排程觸發時間（24小時制，預設 09:00 Asia/Taipei）
META_REPORT_HOUR=9
META_REPORT_MINUTE=0
META_REPORT_TIMEZONE=Asia/Taipei

# 選填，狀態檔位置（預設 meta_ads_automation/state/state.json）
META_ADS_STATE_PATH=
